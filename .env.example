GEMINI_API_KEY=your_google_ai_studio_key

# Optional overrides
IRIS_USER_NAME=there
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Zephyr
CLAUDE_CODE_OAUTH_TOKEN= run claude setup-token to get token for PO

# Hands-free "Hey Iris" wake word (on-device ONNX, only listens while asleep).
# Default: on. Set to 0 to disable (also toggleable from Settings).
# IRIS_WAKE_WORD=1

# How long after Gemini's "go_to_sleep" tool call before Iris actually sleeps
# (gives the spoken goodbye time to play). Default: 3000 (ms).
# IRIS_SLEEP_DELAY_MS=3000

# Global hotkey that toggles the Glass HUD overlay (click-through, floats
# over your desktop) from anywhere, even while another app has focus.
# Default: Alt+Space. Electron accelerator syntax (e.g. "Control+Shift+H").
# IRIS_HUD_HOTKEY=Alt+Space

# Claude Code headless worker settings — all optional.
# Directory Claude works in (also scopes its saved sessions):
# IRIS_CLAUDE_CWD=/Users/you/.iris/workspace
# Permission mode for headless runs. Default is bypassPermissions (fully
# autonomous — Claude can run any tool without asking). Set acceptEdits or
# plan for a more restricted worker:
# IRIS_CLAUDE_PERMISSION_MODE=bypassPermissions
# Full path to the claude binary if the packaged GUI app cannot find it:
# macOS/Linux example:
# IRIS_CLAUDE_BIN=/Users/you/.local/bin/claude
# Windows example:
# IRIS_CLAUDE_BIN=C:\\Users\\you\\AppData\\Local\\Programs\\claude\\claude.exe
# Full path to the openspec CLI if the packaged GUI app cannot find it (used to
# `openspec init` a fresh project — the pipeline's only SDD surface):
# IRIS_OPENSPEC_BIN=/Users/you/.local/bin/openspec

# PREREQUISITE — global skills. The PO/DEV agents run with the globally-installed
# skills in ~/.claude/skills: the OpenSpec workflow skills (openspec-propose,
# openspec-apply-change, openspec-archive-change, ...) and the mattpocock skills
# (grilling, tdd, verify, code-review). Install them once (e.g. their setup
# skills / the openspec CLI) so they are present for every project — same shape
# as the `claude setup-token` prerequisite below. The agents themselves live in
# ~/.claude/agents (installed via the "Install agents" button).

# Subscription token — required for the PO and STUDY roles (both stateful
# Agent SDK sessions). They do NOT reuse your interactive `claude` login.
# Generate a one-time subscription OAuth token:
#   claude setup-token
# then paste it here so PO/STUDY usage bills against your Claude subscription
# instead of the per-token API:
# CLAUDE_CODE_OAUTH_TOKEN=your_setup_token_value
#
# FOOTGUN: if ANTHROPIC_API_KEY is set anywhere in this environment, it
# outranks CLAUDE_CODE_OAUTH_TOKEN and silently switches usage to metered
# API billing. Iris strips ANTHROPIC_API_KEY from the PO and STUDY sessions'
# own environments, but do not set it here unless you intend to pay per token.
# ANTHROPIC_API_KEY is not used by Iris and should be left unset.
#
# STUDY also needs the `open-second-brain` Claude Code plugin enabled (it
# provides the brain_* note tools STUDY writes with). No extra Iris config is
# required — the STUDY SDK session inherits it from your ~/.claude settings.

# How long the PO's live session waits for a voice answer to a mid-turn
# question (AskUserQuestion) before applying its own recommended option.
# Default: 300000 (5 minutes).
# IRIS_PO_QUESTION_TIMEOUT_MS=300000

# Rollback switch: set to 0 to disable the PO live session and fall back to
# the pre-SDK behavior (PO runs one-shot like DEV, no mid-turn questions).
# IRIS_PO_LIVE_SESSION=1

# Per-role model defaults for the PO/DEV/STUDY roles (choose from: claude-fable-5,
# claude-sonnet-5, claude-opus-4-8, claude-haiku-4-5-20251001). Only used when
# the workstream has no model chosen yet from the UI/voice chip — a workstream
# choice always outranks these. Built-in defaults if unset: PO=claude-fable-5,
# DEV=claude-sonnet-5, STUDY=claude-sonnet-5.
# IRIS_PO_MODEL=claude-fable-5
# IRIS_DEV_MODEL=claude-sonnet-5
# IRIS_STUDY_MODEL=claude-sonnet-5

# ── J.A.R.V.I.S Upgrade — Feature Hotkeys ──────────────────────────────────
# Super+Shift+V  : Toggle Live Screen Vision (Feature 1) — Iris sees your screen
# Super+Shift+L  : Toggle Local AI Mode (Feature 3) — routes to Ollama instead of Gemini
# Super+Shift+C  : Toggle Privacy Cam (Feature 5) — blur faces in webcam feed

# Local Ollama model to use when localchat mode is active (Super+Shift+L).
# Run `ollama pull <model>` first. Default: llama3
# Options: llama3, llama3.2, qwen2.5:3b, phi3.5, mistral, etc.
# Requires Ollama running at localhost:11434 (https://ollama.ai)
# IRIS_LOCAL_MODEL=llama3
GEMINI_API_KEY=your_google_ai_studio_key

# Optional overrides
IRIS_USER_NAME=there
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Zephyr
CLAUDE_CODE_OAUTH_TOKEN= run claude setup-token to get token for PO

# Hands-free "Hey Iris" wake word (on-device ONNX, only listens while asleep).
# Default: on. Set to 0 to disable (also toggleable from Settings).
# IRIS_WAKE_WORD=1

# How long after Gemini's "go_to_sleep" tool call before Iris actually sleeps
# (gives the spoken goodbye time to play). Default: 3000 (ms).
# IRIS_SLEEP_DELAY_MS=3000

# Global hotkey that toggles the Glass HUD overlay (click-through, floats
# over your desktop) from anywhere, even while another app has focus.
# Default: Alt+Space. Electron accelerator syntax (e.g. "Control+Shift+H").
# IRIS_HUD_HOTKEY=Alt+Space

# Claude Code headless worker settings — all optional.
# Directory Claude works in (also scopes its saved sessions):
# IRIS_CLAUDE_CWD=/Users/you/.iris/workspace
# Permission mode for headless runs. Default is bypassPermissions (fully
# autonomous — Claude can run any tool without asking). Set acceptEdits or
# plan for a more restricted worker:
# IRIS_CLAUDE_PERMISSION_MODE=bypassPermissions
# Full path to the claude binary if the packaged GUI app cannot find it:
# macOS/Linux example:
# IRIS_CLAUDE_BIN=/Users/you/.local/bin/claude
# Windows example:
# IRIS_CLAUDE_BIN=C:\\Users\\you\\AppData\\Local\\Programs\\claude\\claude.exe
# Full path to the openspec CLI if the packaged GUI app cannot find it (used to
# `openspec init` a fresh project — the pipeline's only SDD surface):
# IRIS_OPENSPEC_BIN=/Users/you/.local/bin/openspec

# PREREQUISITE — global skills. The PO/DEV agents run with the globally-installed
# skills in ~/.claude/skills: the OpenSpec workflow skills (openspec-propose,
# openspec-apply-change, openspec-archive-change, ...) and the mattpocock skills
# (grilling, tdd, verify, code-review). Install them once (e.g. their setup
# skills / the openspec CLI) so they are present for every project — same shape
# as the `claude setup-token` prerequisite below. The agents themselves live in
# ~/.claude/agents (installed via the "Install agents" button).

# Subscription token — required for the PO and STUDY roles (both stateful
# Agent SDK sessions). They do NOT reuse your interactive `claude` login.
# Generate a one-time subscription OAuth token:
#   claude setup-token
# then paste it here so PO/STUDY usage bills against your Claude subscription
# instead of the per-token API:
# CLAUDE_CODE_OAUTH_TOKEN=your_setup_token_value
#
# FOOTGUN: if ANTHROPIC_API_KEY is set anywhere in this environment, it
# outranks CLAUDE_CODE_OAUTH_TOKEN and silently switches usage to metered
# API billing. Iris strips ANTHROPIC_API_KEY from the PO and STUDY sessions'
# own environments, but do not set it here unless you intend to pay per token.
# ANTHROPIC_API_KEY is not used by Iris and should be left unset.
#
# STUDY also needs the `open-second-brain` Claude Code plugin enabled (it
# provides the brain_* note tools STUDY writes with). No extra Iris config is
# required — the STUDY SDK session inherits it from your ~/.claude settings.

# How long the PO's live session waits for a voice answer to a mid-turn
# question (AskUserQuestion) before applying its own recommended option.
# Default: 300000 (5 minutes).
# IRIS_PO_QUESTION_TIMEOUT_MS=300000

# Rollback switch: set to 0 to disable the PO live session and fall back to
# the pre-SDK behavior (PO runs one-shot like DEV, no mid-turn questions).
# IRIS_PO_LIVE_SESSION=1

# Per-role model defaults for the PO/DEV/STUDY roles (choose from: claude-fable-5,
# claude-sonnet-5, claude-opus-4-8, claude-haiku-4-5-20251001). Only used when
# the workstream has no model chosen yet from the UI/voice chip — a workstream
# choice always outranks these. Built-in defaults if unset: PO=claude-fable-5,
# DEV=claude-sonnet-5, STUDY=claude-sonnet-5.
# IRIS_PO_MODEL=claude-fable-5
# IRIS_DEV_MODEL=claude-sonnet-5
# IRIS_STUDY_MODEL=claude-sonnet-5

# ── J.A.R.V.I.S Upgrade — Feature Hotkeys ──────────────────────────────────
# Super+Shift+V  : Toggle Live Screen Vision (Feature 1) — Iris sees your screen
# Super+Shift+L  : Toggle Local AI Mode (Feature 3) — routes to Ollama instead of Gemini
# Super+Shift+C  : Toggle Privacy Cam (Feature 5) — blur faces in webcam feed

# Local Ollama model to use when localchat mode is active (Super+Shift+L).
# Run `ollama pull <model>` first. Default: llama3
# Options: llama3, llama3.2, qwen2.5:3b, phi3.5, mistral, etc.
# Requires Ollama running at localhost:11434 (https://ollama.ai)
# IRIS_LOCAL_MODEL=llama3

# ChromaDB / Second Brain (Feature 4)
# Iris uses a local ChromaDB vector database to remember things you tell it to save.
# ChromaDB runs embedded (no separate server needed) — data stored at ~/.iris/chroma
# No config needed. Just say "Iris, remember this: ..." to save a memory.

# (Tùy chọn) AuthToken từ ngrok (https://dashboard.ngrok.com) dùng cho kết nối Camera/Audio qua Internet (Companion)
IRIS_NGROK_AUTHTOKEN=

# ── Live Teleprompter (Alt+T) — nút "Dịch" và "Nhắc bài" ───────────────────
# Key Anthropic Claude API RIÊNG cho 2 tính năng này (KHÔNG dùng chung biến
# ANTHROPIC_API_KEY ở trên — biến đó dành cho PO/DEV agent và bị Iris cố ý
# strip khỏi môi trường của các session đó). Lấy key tại
# https://console.anthropic.com/settings/keys — key này bị tính phí theo
# token dùng thật (không phải qua gói Claude subscription).
# - "Dịch": dịch từng dòng transcript (kèm 1-2 câu ngữ cảnh gần nhất) sang
#   ngôn ngữ bạn chọn khi bấm nút.
# - "Nhắc bài": nghe hội thoại (qua sidecar/live_transcriber.py) — mic KHÔNG
#   bị tự tắt, chỉ hiển thị gợi ý minh bạch trên HUD — và gợi ý câu trả lời
#   khi phát hiện câu hỏi cần phản hồi. Nếu thiếu key này, tính năng Nhắc bài
#   sẽ tự động fallback tạm sang GEMINI_API_KEY ở trên (chất lượng gợi ý có
#   thể kém hơn); tính năng Dịch thì bắt buộc cần key Claude.
IRIS_TELEPROMPTER_ANTHROPIC_KEY=

# sidecar/live_transcriber.py (nguồn transcript dùng chung cho Dịch/Nhắc bài)
# giờ dùng streaming cloud STT — "Phương án A" đã chốt: Deepgram Nova-3,
# thay cho pipeline cũ (ghi 4 giây rồi mới transcribe bằng Whisper cục bộ độc
# lập từng đoạn). Lấy API key miễn phí ($200 credit dùng thử) tại
# https://console.deepgram.com/signup — model nova-3 hỗ trợ tiếng Việt
# streaming (~dưới 300ms theo Deepgram công bố), giá khoảng $0.0077/phút
# audio (~$0.9/giờ cho cả 2 kênh mic+loopback cùng lúc). Theo dõi chi tiêu tại
# https://console.deepgram.com/ (mục Usage/Billing).
# Audio SẼ được gửi ra ngoài máy tới Deepgram khi bật tính năng này (đã nói
# rõ trong đề xuất ở BƯỚC 1) — nếu để trống, sidecar tự động rớt về lại pipeline
# Whisper cục bộ cũ (không gửi audio ra ngoài, nhưng độ trễ cao hơn mục tiêu
# <1.5s và dễ cắt cụt câu hơn).
DEEPGRAM_API_KEY=

# (Tuỳ chọn) Tinh chỉnh streaming STT — thường không cần đổi:
# Ngôn ngữ nhận diện. Mặc định "vi".
# IRIS_STT_LANGUAGE=vi
# Khoảng lặng (ms) để Deepgram coi là "hết câu" và chốt transcript. Giảm ->
# phản hồi nhanh hơn nhưng dễ cắt cụt câu nói nhanh/ngập ngừng; tăng -> mượt
# hơn nhưng trễ hơn. Mặc định 400.
# IRIS_STT_ENDPOINTING_MS=400
# Lưới an toàn cho trường hợp speech_final không bắn kịp (vd. mạng chập
# chờn) — sau chừng này ms im lặng, đoạn đang gom dở vẫn được chốt và hiển
# thị. Mặc định 1000.
# IRIS_STT_UTTERANCE_END_MS=1000
# Số lần thử nối lại Deepgram trước khi rớt hẳn về Whisper cục bộ cho phần
# còn lại của phiên. Mặc định 5.
# IRIS_STT_MAX_RECONNECTS=5
# Set "1" để in toàn bộ message thô từ Deepgram ra stderr — hữu ích khi cần
# chẩn đoán trong lần chạy thử đầu tiên.
# IRIS_STT_DEBUG=0

# ── Telegram Bot Integration ───────────────────────────────────────────────
# Control Iris remotely via a Telegram Bot.
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_user_id

# -- Smart Home Integration -----------------------------------------------
# SMART_HOME_WEBHOOK_URL=http://your-home-assistant-or-api.com/webhook
# SMART_HOME_TOKEN=your_token_if_needed

# -- OmniParser (Computer Use — độ chính xác toạ độ click) ------------------
# Server thật: reponew/toado/api_server.py (multipart/form-data, field "file",
# trả về {labeled_image_base64, coordinates}). Chạy bằng:
#   cd reponew/toado && python api_server.py   (mặc định lắng nghe port 8000)
# Dùng cho vòng lặp Claude Computer Use trong electron/computer-session.mjs:
# mỗi lần chụp màn hình, ảnh được gửi qua OmniParser để vẽ khung đỏ + đánh số
# các phần tử UI trước khi đưa cho model, giúp click chính xác hơn.
# Bỏ trống / để mặc định là đủ nếu OmniParser chạy ở localhost:8000.
# OMNIPARSER_ANNOTATE_URL=http://127.0.0.1:8000/parse
# Đặt "false" để tắt hẳn bước gọi OmniParser (Computer Use quay lại hành vi
# cũ: Claude tự đoán toạ độ từ ảnh thô, không có khung đỏ).
# OMNIPARSER_ENABLED=true
# Thời gian tối đa (ms) chờ OmniParser trả lời mỗi lần chụp màn hình (YOLO+OCR
# có thể mất hàng chục giây trên máy không có GPU) trước khi bỏ qua và dùng ảnh gốc.
# OMNIPARSER_TIMEOUT_MS=90000

# (Đã có sẵn trong electron/main.mjs cho tính năng "computer_use_omniparser"
# riêng — cùng server, cùng route /parse, nhưng có gửi kèm field "prompt" nên
# server tự gọi Gemini chọn 1 khung duy nhất và trả {target_id, target_center}
# thay vì trả toàn bộ danh sách. Khác mục đích với OMNIPARSER_ANNOTATE_URL ở
# trên — giữ nguyên nếu bạn đang dùng tính năng 1-lần-ăn-ngay đó.
# Cần thêm GEMINI_API_KEY để nhánh "prompt" hoạt động — xem api_server.py.)
# OMNIPARSER_API_URL=http://127.0.0.1:8000/parse
# OMNIPARSER_CLICK_URL=http://127.0.0.1:8000/click
# OMNIPARSER_TYPE_URL=http://127.0.0.1:8000/type

# ── Nâng cấp mới: Browser Agent / Action Lanes / Smart-Home Automation ─────
# Xem chi tiết cách dùng bằng giọng nói trong NANG_CAP_MOI.md

# Browser Agent (electron/browser-agent.mjs) dùng Playwright — không cần
# biến môi trường nào, nhưng phải cài trình duyệt một lần sau khi npm install:
#   npx playwright install chromium
# Mặc định chạy headless (không hiện cửa sổ); Iris có thể mở có cửa sổ nếu
# bạn nói rõ ("mở trình duyệt cho tôi xem"), qua tham số headless=false.

# Action lanes (electron/action-lane.mjs) không cần cấu hình — giới hạn số
# việc chạy song song theo từng loại (computer/browser/smarthome) đã được
# đặt sẵn hợp lý trong code. Chỉnh trực tiếp trong file đó nếu muốn đổi.

# Smart-home automation rules (electron/smarthome-rules.mjs) lưu tại
# ~/.iris/smarthome-rules.json, tự tạo khi cần — không cần biến môi trường.
# Vòng lặp kiểm tra rule chạy mỗi 20 giây, dùng lại đúng cơ chế điều khiển
# thiết bị hiện có của trigger_smart_home / robots.json.
