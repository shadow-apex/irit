{
  "name": "iris-claude-voice",
  "productName": "Iris",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A futuristic Gemini Live voice companion that delegates real work to Claude Code running headless.",
  "homepage": "https://github.com/shadow-apex/irit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadow-apex/irit.git"
  },
  "bugs": {
    "url": "https://github.com/shadow-apex/irit/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "npx --yes kill-port 5173 8080 8081 4040 8443 8000 && taskkill /F /IM ngrok.exe >nul 2>&1 || exit 0",
    "dev": "concurrently -k -n VITE,ELECTRON,PHONE,OMNI -c cyan,magenta,yellow,blue \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && node scripts/run-electron.mjs\" \"npm run camera\" \"python reponew/toado/api_server.py\"",
    "camera": "node -e \"require('fs').existsSync('PHONE_CAMERA/node_modules')||require('child_process').execSync('npm install',{cwd:'PHONE_CAMERA',stdio:'inherit'})\" && node PHONE_CAMERA/server.js",
    "camera:install": "npm install --prefix PHONE_CAMERA",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && node scripts/run-electron.mjs --prod",
    "start:prod": "node scripts/run-electron.mjs --prod",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "electron": "node scripts/run-electron.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.210",
    "@anthropic-ai/sdk": "^0.112.3",
    "@google/genai": "^2.10.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@vitejs/plugin-react": "latest",
    "chromadb": "^3.5.0",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "mqtt": "^5.15.2",
    "ngrok": "^5.0.0-beta.2",
    "node-telegram-bot-api": "^1.2.0",
    "ollama": "^0.6.3",
    "onnxruntime-web": "^1.27.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.181.2",
    "typescript": "latest",
    "vite": "latest",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "wait-on": "latest"
  },
  "build": {
    "appId": "app.iris.voice",
    "productName": "Iris",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/personas",
        "to": "personas"
      },
      {
        "from": "resources/project-seed",
        "to": "project-seed"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
