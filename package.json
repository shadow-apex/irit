{
  "name": "iris-claude-voice",
  "productName": "Iris",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A futuristic Gemini Live voice companion that delegates real work to Claude Code running headless.",
  "homepage": "https://github.com/shadow-apex/irit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadow-apex/irit.git"
  },
  "bugs": {
    "url": "https://github.com/shadow-apex/irit/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "npx --yes kill-port 5173 8080 8081 4040 8444 8000 || exit 0 && node scripts/prepare-mediapipe.mjs",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && node scripts/run-electron.mjs\"",
    "dev:with-legacy-obs-cam": "concurrently -k -n VITE,ELECTRON,PHONE -c cyan,magenta,yellow \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && node scripts/run-electron.mjs\" \"npm run camera\"",
    "camera": "node -e \"require('fs').existsSync('PHONE_CAMERA/node_modules')||require('child_process').execSync('npm install',{cwd:'PHONE_CAMERA',stdio:'inherit'})\" && node PHONE_CAMERA/server.js",
    "camera:install": "npm install --prefix PHONE_CAMERA",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "npm run build && node scripts/run-electron.mjs --prod",
    "start:prod": "node scripts/run-electron.mjs --prod",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "electron": "node scripts/run-electron.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "setup:mediapipe": "node scripts/prepare-mediapipe.mjs",
    "setup:ort": "node scripts/prepare-ort.mjs",
    "test:py": "python -m unittest discover -s tools/tests"
  },
  "dependencies": {
    "3d-force-graph": "1.80.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.210",
    "@anthropic-ai/sdk": "^0.112.3",
    "@chroma-core/default-embed": "^0.1.9",
    "@excalidraw/excalidraw": "0.18.1",
    "@google/genai": "^2.10.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@vitejs/plugin-react": "6.0.3",
    "chromadb": "^3.5.0",
    "express": "^5.2.1",
    "fractional-indexing": "3.2.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.21.0",
    "mqtt": "^5.15.2",
    "ngrok": "^5.0.0-beta.2",
    "node-telegram-bot-api": "^1.2.0",
    "ollama": "^0.6.3",
    "onnxruntime-web": "^1.27.0",
    "playwright": "^1.49.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.181.2",
    "typescript": "^7.0.2",
    "vite": "8.1.0",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.5",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "app.iris.voice",
    "productName": "Iris",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/trayTemplate.png",
      "build/trayTemplate@2x.png",
      "package.json",
      "tools/**",
      "sidecar/**",
      "public/**",
      "robots.example.json",
      "smarthome_cameras.example.json",
      ".agents/**"
    ],
    "extraResources": [
      {
        "from": "resources/personas",
        "to": "personas"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "asarUnpack": [
      "tools/**",
      "sidecar/**"
    ]
  },
  "optionalDependencies": {
    "windows-media-sessions": "^1.0.3"
  }
}
